{
  "name": "FNF Codespace Player",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8080, 6080],
  "portsAttributes": {
    "8080": {
      "label": "FNF web player",
      "onAutoForward": "openPreview"
    },
    "6080": {
      "label": "Native game viewer (noVNC)",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "chmod +x start.sh"
}
